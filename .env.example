APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Identitas Sekolah (dipakai pada kop laporan & surat)
# ---------------------------------------------------------------------------
SEKOLAH_NAMA="SD Negeri 1 Nusantara"
SEKOLAH_DINAS="Dinas Pendidikan dan Kebudayaan Kota Nusantara"
SEKOLAH_NPSN=20123456
SEKOLAH_ALAMAT="Jl. Pendidikan No. 1, Kecamatan Nusantara, Kota Nusantara 40123"
SEKOLAH_TELEPON="(022) 123456"
SEKOLAH_KEPSEK="Ahmad Sutrisno, S.Pd., M.M."
SEKOLAH_KEPSEK_NIP="19700101 199001 1 001"
SEKOLAH_PUSTAKAWAN="Sri Wahyuni, S.Pd."
SEKOLAH_PUSTAKAWAN_NIP="19850202 200801 2 002"

# ---------------------------------------------------------------------------
# Aturan Peminjaman
# ---------------------------------------------------------------------------
PERPUS_TAHUN_AJARAN=2025/2026
PERPUS_LOAN_DAYS=7
PERPUS_MAX_LOANS=2

# ---------------------------------------------------------------------------
# Denda Keterlambatan
# ---------------------------------------------------------------------------
# Dihitung per HARI SEKOLAH (Senin-Jumat). Sabtu/Minggu dan hari libur
# nasional tidak dihitung, jadi buku jatuh tempo Jumat yang dikembalikan
# Senin tidak incur denda.
# Denda dibayar di loket. Siswa yang masih punya denda belum lunas
# otomatis tidak bisa meminjaman buku lagi.
PERPUS_DENDA_PER_HARI=500
PERPUS_DENDA_MAKS=10000
PERPUS_DENDA_BLOKIR=true
# Cuti bersama = kantor pemerintah tutup. Sekolah sering masih mengajar,
# ubah ke false bila ingin tetap menghitungnya sebagai hari sekolah.
PERPUS_HITUNG_CUTI_BERSAMA=true

# PENTING: daftar hari libur nasional & cuti bersama berada di
# config/perpustakaan.php pada kunci 'fine.holidays' dan 'fine.joint_leaves'.
# Wajib ditambah setiap tahun karena tanggal hijriah bergeser 1-2 hari.

# ---------------------------------------------------------------------------
# Cadangan Database (Backup Otomatis)
# ---------------------------------------------------------------------------
# Dijalankan oleh cron server: php artisan schedule:run (setiap menit)
#   atau php artisan schedule:work (untuk mencoba secara lokal)
PERPUS_BACKUP_JADWAL=daily
PERPUS_BACKUP_WAKTU=23:00
# Jumlah file backup yang disimpan sebelum yang lama dihapus (rotasi).
PERPUS_BACKUP_KEEP=14
# PERPUS_BACKUP_PATH="C:/pustaka/backup"
